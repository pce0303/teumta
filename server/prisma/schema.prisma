// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        String   @id @default(cuid())
  message   String   @default("teumta")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PlaceType {
  TOURIST_SPOT
  LOCAL_PLACE
}

model Place {
  id                  Int       @id @default(autoincrement())
  name                String
  type                PlaceType
  address             String?
  // 관광지/로컬 장소의 "고정 좌표"다(사용자 위치가 아님). 서버 관리 대상.
  latitude            Decimal   @db.Decimal(10, 7)
  longitude           Decimal   @db.Decimal(10, 7)
  imageUrl            String?   @db.Text
  description         String?   @db.Text
  openingTime         String?   @db.VarChar(5)
  closingTime         String?   @db.VarChar(5)
  recommendedDuration Int?
  tourApiContentId    String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  placeTags   PlaceTag[]
  congestions Congestion[]
  mainRoutes  Route[]      @relation("MainPlaceRoutes")
  routeStops  RouteStop[]
  tripEvents  TripEvent[]
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  placeTags PlaceTag[]
}

model PlaceTag {
  placeId Int
  tagId   Int

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([placeId, tagId])
  @@index([tagId])
}

enum CongestionType {
  PREDICTED
  REALTIME
}

enum CongestionLevel {
  RELAXED
  NORMAL
  CROWDED
  VERY_CROWDED
}

model Congestion {
  id           Int             @id @default(autoincrement())
  placeId      Int
  type         CongestionType
  level        CongestionLevel
  score        Int?
  measuredAt   DateTime?
  predictedFor DateTime?
  source       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@index([placeId, measuredAt])
  @@index([placeId, predictedFor])
}

model Route {
  id                   Int      @id @default(autoincrement())
  name                 String
  mainPlaceId          Int
  description          String?  @db.Text
  estimatedTotalDurationMinutes Int?
  estimatedTotalDistanceMeters  Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  mainPlace Place       @relation("MainPlaceRoutes", fields: [mainPlaceId], references: [id])
  stops     RouteStop[]
  trips     Trip[]

  @@index([mainPlaceId])
}

model RouteStop {
  id                         Int  @id @default(autoincrement())
  routeId                    Int
  placeId                    Int
  stopOrder                  Int
  stayMinutes                Int?
  estimatedTravelMinutesFromPrevious  Int?
  estimatedDistanceMetersFromPrevious Int?

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id])

  @@unique([routeId, stopOrder])
  @@index([placeId])
}

enum TripStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Trip {
  id        Int        @id @default(autoincrement())
  routeId   Int
  status    TripStatus @default(PLANNED)
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  route  Route       @relation(fields: [routeId], references: [id])
  events TripEvent[]

  @@index([routeId])
}

// 개인정보 최소화(privacy): 사용자 위치를 서버에 저장하지 않는다.
// - 장기 유지되는 device identifier(deviceId)는 저장하지 않는다. Trip 식별이 필요하면
//   Trip 자체의 id(또는 Trip 한정 랜덤 session id)를 사용한다.

enum TripEventType {
  TRIP_STARTED
  PLACE_ARRIVED
  PLACE_LEFT
  MAIN_PLACE_RETURNED
  TRIP_COMPLETED
  TRIP_CANCELLED
}

// 개인정보 최소화(privacy): 사용자의 실제 GPS 좌표는 서버에 저장하지 않는다.
// - latitude/longitude 필드는 의도적으로 두지 않는다(단말기 내부에서만 처리).
// - metadata에도 사용자 위치(현재 좌표/이동경로 등)를 절대 넣지 않는다.
//   진행상태(도착/출발/복귀 등)의 GPS 판정은 mobile local state에서만 수행한다.
model TripEvent {
  id         Int           @id @default(autoincrement())
  tripId     Int
  placeId    Int?
  eventType  TripEventType
  occurredAt DateTime      @default(now())
  metadata   Json?

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place Place? @relation(fields: [placeId], references: [id])

  @@index([tripId, occurredAt])
  @@index([placeId])
  @@index([eventType])
}

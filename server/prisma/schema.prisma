generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        String   @id @default(cuid())
  message   String   @default("teumta")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PlaceType {
  TOURIST_SPOT
  LOCAL_PLACE
}

model Place {
  id                  Int       @id @default(autoincrement())
  name                String
  type                PlaceType
  address             String?
  // 관광지/로컬 장소의 "고정 좌표"다(사용자 위치가 아님). 서버 관리 대상.
  latitude            Decimal   @db.Decimal(10, 7)
  longitude           Decimal   @db.Decimal(10, 7)
  imageUrl            String?   @db.Text
  description         String?   @db.Text
  openingTime         String?   @db.VarChar(5)
  closingTime         String?   @db.VarChar(5)
  recommendedDuration Int?
  tourApiContentId    String?   @unique
  // TourAPI(KorService2 v4.4) 최신 법정동 코드/분류체계. 집중률 예측(TatsCnctrRateService)의
  // areaCd/signguCd 기반 지역 매칭에 사용한다. 미수집 데이터는 null.
  lDongRegnCd         String?   @db.VarChar(8)
  lDongSignguCd       String?   @db.VarChar(8)
  lclsSystm1          String?   @db.VarChar(16)
  lclsSystm2          String?   @db.VarChar(16)
  lclsSystm3          String?   @db.VarChar(16)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  placeTags       PlaceTag[]
  congestions     Congestion[]
  mainRoutes      Route[]              @relation("MainPlaceRoutes")
  routeStops      RouteStop[]
  tripEvents      TripEvent[]
  forecastAliases ForecastPlaceAlias[]

  @@index([lDongRegnCd, lDongSignguCd])
}

// KTO 집중률 예측 관광지명 ↔ Place 수동 매칭(관리자 확정 별칭).
// 자동 매칭(지역+정규화 이름 정확 일치)이 UNMATCHED/AMBIGUOUS인 항목을 관리자가
// 지정하면 적재 시 이 매핑을 자동 매칭보다 우선 사용한다.
// tAtsNm은 normalizePlaceName(prediction.matcher) 적용 후 저장한다.
model ForecastPlaceAlias {
  id        Int      @id @default(autoincrement())
  areaCd    String   @db.VarChar(8)
  signguCd  String   @db.VarChar(8)
  tAtsNm    String   @db.VarChar(191)
  placeId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([areaCd, signguCd, tAtsNm])
  @@index([placeId])
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  placeTags PlaceTag[]
}

model PlaceTag {
  placeId Int
  tagId   Int

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([placeId, tagId])
  @@index([tagId])
}

enum CongestionType {
  PREDICTED
  REALTIME
}

enum CongestionLevel {
  RELAXED
  NORMAL
  CROWDED
  VERY_CROWDED
}

model Congestion {
  id           Int             @id @default(autoincrement())
  placeId      Int
  type         CongestionType
  // KTO 집중률 예측(TatsCnctrRateService)은 등급 임계값을 제공하지 않으므로 level 없이 저장한다.
  // 공식 기준 없이 임의 등급을 만들지 않기 위해 nullable로 둔다.
  level        CongestionLevel?
  score        Int?
  // KTO 집중률 예측의 원본 소수값(cnctrRate). 실시간·시간대별 데이터가 아닌 일 단위 예측치.
  concentrationRate Decimal?   @db.Decimal(5, 2)
  measuredAt   DateTime?
  predictedFor DateTime?
  source       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, source, predictedFor])
  @@index([placeId])
  @@index([placeId, measuredAt])
  @@index([placeId, predictedFor])
}

model Route {
  id                   Int      @id @default(autoincrement())
  name                 String
  mainPlaceId          Int
  description          String?  @db.Text
  estimatedTotalDurationMinutes Int?
  estimatedTotalDistanceMeters  Int?

  // 마지막 RouteStop → mainPlace 복귀 구간. RouteStop의 경로 필드는 모두 "이전 장소 → 현재 정류지"
  // 기준이라 복귀 구간을 담을 자리가 없어 Route에 둔다(api-spec §6.5).
  // 전부 null이면 복귀 미포함 코스다.
  // privacy: RouteStop.pathFromPrevious와 동일하게 Place↔Place 고정 경로이며 사용자 GPS가 아니다.
  returnTravelMinutes  Int?
  returnDistanceMeters Int?
  returnPath           Json?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  mainPlace Place       @relation("MainPlaceRoutes", fields: [mainPlaceId], references: [id])
  stops     RouteStop[]
  trips     Trip[]

  @@index([mainPlaceId])
}

model RouteStop {
  id                         Int  @id @default(autoincrement())
  routeId                    Int
  placeId                    Int
  stopOrder                  Int
  stayMinutes                Int?
  estimatedTravelMinutesFromPrevious  Int?
  estimatedDistanceMetersFromPrevious Int?

  // 이전 정류지(첫 정류지는 mainPlace)에서 이 정류지까지의 보행 경로 도형.
  // TMAP Place↔Place 경로에서 추출한 [{ latitude, longitude }, ...] 배열이며 지도 폴리라인 렌더링용.
  // privacy: 장소 사이의 고정 경로 데이터다. 사용자 GPS/이동 기록을 저장하는 필드가 아니다.
  pathFromPrevious           Json?

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id])

  @@unique([routeId, stopOrder])
  @@index([placeId])
}

enum TripStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Trip {
  id        Int        @id @default(autoincrement())
  routeId   Int
  status    TripStatus @default(PLANNED)
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  route  Route       @relation(fields: [routeId], references: [id])
  events TripEvent[]

  @@index([routeId])
}

// 개인정보 최소화(privacy): 사용자 위치를 서버에 저장하지 않는다.
// - 장기 유지되는 device identifier(deviceId)는 저장하지 않는다. Trip 식별이 필요하면
//   Trip 자체의 id(또는 Trip 한정 랜덤 session id)를 사용한다.

enum TripEventType {
  TRIP_STARTED
  PLACE_ARRIVED
  PLACE_LEFT
  MAIN_PLACE_RETURNED
  TRIP_COMPLETED
  TRIP_CANCELLED
}

// 개인정보 최소화(privacy): 사용자의 실제 GPS 좌표는 서버에 저장하지 않는다.
// - latitude/longitude 필드는 의도적으로 두지 않는다(단말기 내부에서만 처리).
// - metadata에도 사용자 위치(현재 좌표/이동경로 등)를 절대 넣지 않는다.
//   진행상태(도착/출발/복귀 등)의 GPS 판정은 mobile local state에서만 수행한다.
model TripEvent {
  id         Int           @id @default(autoincrement())
  tripId     Int
  placeId    Int?
  eventType  TripEventType
  occurredAt DateTime      @default(now())
  metadata   Json?

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place Place? @relation(fields: [placeId], references: [id])

  @@index([tripId, occurredAt])
  @@index([placeId])
  @@index([eventType])
}

PORT=3000
DATABASE_URL="mysql://teumta:change_me@localhost:3306/teumta"

# 외부 API 인증키 (실제 키는 .env 에만 작성, Git 커밋 금지)
TOUR_API_KEY=
CONGESTION_API_KEY=
TMAP_API_KEY=
PREDICTION_API_KEY=

# 외부 API base URL (공식 스펙 확인 후 채움)
# TourAPI(KorService2). 승인된 서비스가 KorService1이면 끝의 2를 뺀 URL/오퍼레이션명을 사용.
TOUR_API_BASE_URL=http://apis.data.go.kr/B551011/KorService2
CONGESTION_API_BASE_URL=
TMAP_API_BASE_URL=https://apis.openapi.sk.com
PREDICTION_API_BASE_URL=

# 외부 API 공통 요청 timeout (ms)
EXTERNAL_API_TIMEOUT_MS=5000
